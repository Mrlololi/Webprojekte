{"lang":"mt","generated":"Generated from phrases.json by tools/build.mjs. Do not edit.","phrases":[{"n":1,"id":"intro.hello","group":"intro","lang":"mt","text":"Ħello","checked":false,"note":"Young Maltese mostly greet with the English loan \"Hello\" (Maltese spelling Ħello) or \"Ċaw\"; \"Bonġu\" is also used as hello until about midday."},{"n":2,"id":"intro.morning","group":"intro","lang":"mt","text":"Bonġu","checked":false,"note":""},{"n":3,"id":"intro.myname","group":"intro","lang":"mt","text":"Jisimni {X}","checked":false,"note":""},{"n":4,"id":"intro.yourname","group":"intro","lang":"mt","text":"X'jismek?","checked":false,"note":""},{"n":5,"id":"intro.nice","group":"intro","lang":"mt","text":"Għandi pjaċir nafek","checked":false,"note":"Not fully sure this is the most common wording; the short \"Pjaċir\" is also very common."},{"n":6,"id":"intro.wherefrom","group":"intro","lang":"mt","text":"Minn fejn int?","checked":false,"note":""},{"n":7,"id":"intro.iamfrom","group":"intro","lang":"mt","text":"Jien minn {X}","checked":false,"note":"With country names that take the article, minn + il- contracts: mill-Ġermanja, mill-Italja (but minn Malta, minn Franza)."},{"n":8,"id":"intro.bye","group":"intro","lang":"mt","text":"Ċaw","checked":false,"note":""},{"n":9,"id":"intro.tomorrow","group":"intro","lang":"mt","text":"Narak għada","checked":false,"note":""},{"n":10,"id":"polite.please","group":"polite","lang":"mt","text":"Jekk jogħġbok","checked":false,"note":""},{"n":11,"id":"polite.thanks","group":"polite","lang":"mt","text":"Grazzi","checked":false,"note":""},{"n":12,"id":"polite.sorry","group":"polite","lang":"mt","text":"Skużani","checked":false,"note":""},{"n":13,"id":"polite.yes","group":"polite","lang":"mt","text":"Iva","checked":false,"note":""},{"n":14,"id":"polite.no","group":"polite","lang":"mt","text":"Le","checked":false,"note":""},{"n":15,"id":"polite.noproblem","group":"polite","lang":"mt","text":"M'hemmx problema","checked":false,"note":""},{"n":16,"id